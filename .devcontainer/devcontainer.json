{
  "name": "CampusFlow POC - Java 17 and H2",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "CampusFlow POC",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "postCreateCommand": "mvn -B -ntp verify",
  "postStartCommand": "bash .devcontainer/start-poc.sh",
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack"] }
  }
}

# Persistent H2 file database; no database server needed. Account passwords are BCrypt hashes.
# On a host, use a persistent disk path such as /data/campusflow.
H2_DATA_PATH=./data/campusflow
DB_USERNAME=sa
DB_PASSWORD=replace-locally
ADMIN_PIN=ADMIN-CM-001
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_MOBILE=9876543210
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Campus Administrator
PORT=8080
# Set true behind HTTPS in production.
COOKIE_SECURE=false
# Optional Twilio SMS. Leave blank until configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional Gmail SMTP. Use a Google App Password, never your Gmail login password.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# HODs register in the app and wait for Admin approval. Teachers select an approved HOD as mentor.
# Future MySQL only: SPRING_PROFILES_ACTIVE=mysql and DB_URL=jdbc:mysql://HOST:3306/campusflow
# Change DB_USERNAME/DB_PASSWORD too. Existing H2 data is NOT migrated automatically.
